# Copier ce fichier en `.env` et renseigner les clés (gratuites).

# Ticketmaster Discovery — https://developer.ticketmaster.com (clé gratuite)
VITE_TICKETMASTER_KEY=

# OpenAgenda — https://openagenda.com (clé gratuite, événements en France)
VITE_OPENAGENDA_KEY=

# Google Places (New) — vraies photos des hébergements « Où dormir » (facultatif).
# Console Google Cloud : activer « Places API (New) » + la facturation (quota gratuit
# mensuel, payant au-delà), puis restreindre la clé par référent HTTP — elle est
# visible côté navigateur. Sans clé : photos d'illustration.
VITE_GOOGLE_PLACES_KEY=
